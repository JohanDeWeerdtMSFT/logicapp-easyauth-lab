        <mxCell id="lab1-client" value="Caller&lt;br/&gt;direct to Logic App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lab1">
          <mxGeometry x="30" y="90" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab1-easyauth" value="Easy Auth middleware&lt;br/&gt;validates requests with Authorization header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lab1">
          <mxGeometry x="250" y="90" width="240" height="70" as="geometry" />
