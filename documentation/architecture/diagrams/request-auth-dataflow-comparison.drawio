        <mxCell id="lab1" value="Lab 1: Easy Auth on Logic App" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#eef6ff;strokeColor=#0078D4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1500" height="280" as="geometry" />
