          <mxGeometry x="560" y="90" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab1-runtime" value="Logic App runtime&lt;br/&gt;workflow trigger and SAS evaluation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lab1">
          <mxGeometry x="810" y="90" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab1-portal" value="Portal or ARM hostruntime request&lt;br/&gt;no app bearer token at Easy Auth boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lab1">
          <mxGeometry x="250" y="180" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab1-note" value="Current evidence:&lt;br/&gt;AllowAnonymous preserves validated hostruntime operations.&lt;br/&gt;Return401 blocks them before runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="lab1">
          <mxGeometry x="1090" y="90" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lab1-noauth" value="No Authorization header&lt;br/&gt;runtime decides outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="lab1">
          <mxGeometry x="560" y="180" width="170" height="70" as="geometry" />
        </mxCell>
