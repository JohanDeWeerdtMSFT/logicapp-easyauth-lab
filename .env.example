# Azure Easy Auth Lab Configuration
# Copy this file to .env and customize the values below

# ================================================================
# REQUIRED: Azure Subscription Information
# ================================================================

# Your Azure Subscription ID
# Find it: az account list --query "[].id"
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Your Azure Tenant ID (also called Directory ID)
# Find it: az account show --query tenantId
AZURE_TENANT_ID=your-tenant-id-here

# Application (client) ID of the app registration representing the Logic App API.
# The expected token audience is api://<this-client-id>.
ENTRA_APP_CLIENT_ID=your-logic-app-client-id-here

# Application (client) ID of the second app registration representing the caller Function App.
FUNC_CALLER_ENTRA_CLIENT_ID=your-caller-function-client-id-here

# ================================================================
# OPTIONAL: Deployment Configuration
# ================================================================

# Azure region where resources will be created
# Examples: eastus, westeurope, swedencentral, australiaeast
# Default: westeurope
AZURE_REGION=westeurope

# Environment name (used in resource names)
# Examples: dev, test, prod
# Default: dev
ENVIRONMENT_NAME=dev

# Your email or name (used to tag resources)
# Examples: john@company.com, johndoe, lab-user
YOUR_EMAIL=your-email-here

# ================================================================
# OPTIONAL: Advanced Settings
# ================================================================

# Resource Group name (if empty, auto-generated from environment)
# Format: rg-easyauth-lab-{ENVIRONMENT_NAME}
# Leave empty to use default
RESOURCE_GROUP_NAME=

# Function App name suffix (if empty, auto-generated)
# Final name: la-easyauth-lab-{ENVIRONMENT_NAME}-caller-{suffix}
# Leave empty to use default
FUNCTION_APP_SUFFIX=

# Logic App name suffix (if empty, auto-generated)
# Final name: la-easyauth-lab-{ENVIRONMENT_NAME}-la-{suffix}
# Leave empty to use default
LOGICAPP_SUFFIX=

# Application Insights name (if empty, auto-generated)
# Default: la-easyauth-lab-{ENVIRONMENT_NAME}-ai
APP_INSIGHTS_NAME=

# ================================================================
# REFERENCE: How to Find These Values
# ================================================================

# Subscription ID:
#   az account list --query "[].{name:name, subscriptionId:id}" --output table
#   Then copy the subscriptionId for your subscription

# Tenant ID:
#   az account show --query tenantId --output tsv
#   Or go to Azure Portal → Entra ID → Overview → Tenant ID

# Supported regions:
#   az account list-locations --query "[].name" -o table

# ================================================================
# NOTES FOR THIS LAB
# ================================================================

# This lab demonstrates PASSWORDLESS authentication, so you should
# NOT need to provide any secrets, connection strings, or API keys.
#
# All authentication uses:
#   • Managed Identity (automatic credentials)
#   • Bearer Tokens (issued by Entra ID, no storage needed)
#   • Easy Auth (server-side validation)
#
# Configuration changes:
#   1. Edit this file with your values
#   2. Save as .env (remove .example)
#   3. Run scripts/deploy.ps1 with -DeployFuncCallerDemo and pass the two
#      app-registration client IDs shown above
#   4. scripts/deploy.ps1 reads AZURE_SUBSCRIPTION_ID from .env when
#      -SubscriptionId is not supplied
#
# No SAS tokens, API keys, or application secrets are required for the learner call.
