      "name": "[format('{0}/{1}', format('{0}-apim-{1}', variables('baseName'), variables('suffix')), 'tenant-id')]",
      "properties": {
        "displayName": "tenant-id",
        "value": "[parameters('entraAppTenantId')]",
        "secret": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service', format('{0}-apim-{1}', variables('baseName'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service/namedValues",
      "apiVersion": "2023-09-01-preview",
      "name": "[format('{0}/{1}', format('{0}-apim-{1}', variables('baseName'), variables('suffix')), 'client-id')]",
      "properties": {
        "displayName": "client-id",
        "value": "[parameters('entraAppClientId')]",
        "secret": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service', format('{0}-apim-{1}', variables('baseName'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service/backends",
      "apiVersion": "2023-09-01-preview",
      "name": "[format('{0}/{1}', format('{0}-apim-{1}', variables('baseName'), variables('suffix')), 'logic-app-backend')]",
      "properties": {
        "url": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('logicAppName')), '2023-12-01').defaultHostName)]",
        "protocol": "http",
        "description": "Logic App Standard backend (no Easy Auth)"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service', format('{0}-apim-{1}', variables('baseName'), variables('suffix')))]",
        "[resourceId('Microsoft.Web/sites', variables('logicAppName'))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service/apis",
      "apiVersion": "2023-09-01-preview",
      "name": "[format('{0}/{1}', format('{0}-apim-{1}', variables('baseName'), variables('suffix')), 'logic-app-workflows')]",
      "properties": {
        "displayName": "Logic App Workflows",
        "path": "workflows",
        "protocols": [
          "https"
        ],
        "serviceUrl": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('logicAppName')), '2023-12-01').defaultHostName)]",
        "subscriptionRequired": false,
        "apiType": "http"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service', format('{0}-apim-{1}', variables('baseName'), variables('suffix')))]",
        "[resourceId('Microsoft.Web/sites', variables('logicAppName'))]",
        "[resourceId('Microsoft.ApiManagement/service/namedValues', format('{0}-apim-{1}', variables('baseName'), variables('suffix')), 'client-id')]",
        "[resourceId('Microsoft.ApiManagement/service/namedValues', format('{0}-apim-{1}', variables('baseName'), variables('suffix')), 'tenant-id')]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/policies",
