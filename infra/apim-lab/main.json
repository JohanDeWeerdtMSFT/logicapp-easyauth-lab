    "appInsightsConnectionString": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/components', format('{0}-ai', variables('baseName'))), '2020-02-02').ConnectionString]"
    },
    "apimName": {
      "type": "string",
      "value": "[format('{0}-apim-{1}', variables('baseName'), variables('suffix'))]"
