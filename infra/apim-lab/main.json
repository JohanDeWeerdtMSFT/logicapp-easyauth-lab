      "properties": {
        "displayName": "GET all paths",
        "method": "GET",
        "urlTemplate": "/*"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', format('{0}-apim-{1}', variables('baseName'), variables('suffix')), 'logic-app-workflows')]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/operations",
      "apiVersion": "2023-09-01-preview",
      "name": "[format('{0}/{1}/{2}', format('{0}-apim-{1}', variables('baseName'), variables('suffix')), 'logic-app-workflows', 'post-all')]",
      "properties": {
        "displayName": "POST all paths",
        "method": "POST",
        "urlTemplate": "/*"
      },
